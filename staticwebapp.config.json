{
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["owner"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    }
  },
  "globalHeaders": {
    "Cache-Control": "no-cache"
  },
  "navigationFallback": {
    "rewrite": "/index.html"
  }
}
